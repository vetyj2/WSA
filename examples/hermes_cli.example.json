{
  "adapter": "cli",
  "agent_harness": {
    "autonomy_policy": {
      "canon_policy": "Autonomous generation may produce candidates; canon mutation still follows the user's Hermes runtime policy and WSA ticket or callback review flow.",
      "checkpoint_policy": {
        "examples": [
          "until the requested outline is ready for review",
          "until three contrasting candidates are available",
          "until the user-defined review condition is met"
        ],
        "natural_language_allowed": true,
        "on_checkpoint": "summarize candidates and request user decision",
        "recommended": true
      },
      "discretion_customizable": true,
      "discretion_scale": {
        "0": {
          "agent_may": [
            "organize answers",
            "surface contradictions",
            "ask follow-up questions"
          ],
          "agent_must_not": [
            "invent canon candidates without explicit request"
          ],
          "cron_allowed": false,
          "label": "author_only",
          "summary": "Hermes asks before filling any world detail."
        },
        "1": {
          "agent_may": [
            "draft alternatives",
            "recommend one option with reasons"
          ],
          "agent_must_not": [
            "fill missing details as if accepted"
          ],
          "cron_allowed": false,
          "label": "ask_before_filling",
          "summary": "Hermes may propose small options, then waits for author selection."
        },
        "2": {
          "agent_may": [
            "fill names, placeholders, and low-risk connective tissue"
          ],
          "agent_must_not": [
            "change major premise, faction power, or protagonist frame"
          ],
          "cron_allowed": false,
          "label": "small_gaps_allowed",
          "summary": "Hermes may fill minor connective details as candidates."
        },
        "3": {
          "agent_may": [
            "draft institutions, locations, customs, and scene hooks"
          ],
          "agent_must_not": [
            "canonize generated material without review"
          ],
          "cron_allowed": false,
          "label": "balanced_fill",
          "summary": "Hermes may prefill ordinary supporting details and report assumptions."
        },
        "4": {
          "agent_may": [
            "run larger fill passes",
            "prepare candidate reports for approval"
          ],
          "agent_must_not": [
            "run unattended cron loops without a level-5 agreement"
          ],
          "cron_allowed": false,
          "label": "broad_agent_fill",
          "summary": "Hermes may generate broad lower-layer world material as candidate sets."
        },
        "5": {
          "agent_may": [
            "prepare recurring lower-layer generation",
            "stop when the destination checkpoint is met",
            "perform a quality gate before completion"
          ],
          "agent_must_not": [
            "start without a destination checkpoint",
            "continue after the checkpoint is met",
            "canonize generated material without approval"
          ],
          "completion_policy": "stop_cron_then_report_quality_and_request_approval",
          "cron_allowed": true,
          "label": "challenge_world_autonomy",
          "requires_destination_checkpoint": true,
          "summary": "Hermes may run cron-capable autonomous fill loops toward a destination checkpoint."
        }
      },
      "enforcement": "guidance_only",
      "fill_the_rest": {
        "approval_flow": "report_candidates_then_request_user_approval",
        "available_anytime": true,
        "candidate_scope": "lower_layer_information",
        "canon_policy": "generated_material_requires_user_or_policy_approval",
        "completion_must_state_cron_stopped": true,
        "cron_capable_at_discretion_level": 5,
        "cron_owner": "user_hermes_runtime",
        "must_stop_when_destination_met": true,
        "owner": "user_hermes_runtime",
        "purpose": "Prepare lower-layer autonomous candidate generation until a destination checkpoint.",
        "quality_gate": {
          "checks": [
            "destination_checkpoint_satisfied",
            "internal_consistency_reviewed",
            "duplicate_or_low_value_fill_removed",
            "approval_report_created"
          ],
          "required_before_completion": true
        },
        "requires_destination_checkpoint": true,
        "schema": "wsa.hermes.fill_the_rest_contract.v1"
      },
      "external_runtime_policy_required_for_autonomous_generation": true,
      "fully_autonomous_generation_allowed": false,
      "owner": "user_hermes_runtime_dialogue",
      "range": {
        "max": 100,
        "min": 0
      }
    },
    "expected_cwd": "workspace_root",
    "meeting_mode": {
      "purpose": "representative diagnosis and proposal gathering",
      "world_mutation": "proposal_only"
    },
    "path_policy": "relative_to_workspace_root",
    "read_roots": [
      "."
    ],
    "schema": "wsa.hermes.agent_harness.v1",
    "world_state_policy": {
      "direct_db_writes": false,
      "direct_world_file_mutation": false,
      "use_tickets_or_callbacks_for_changes": true
    },
    "write_roots": [
      "hermes/callbacks",
      "hermes/callback_archive",
      "hermes/reports_outbox",
      "hermes/maintenance",
      "hermes/task_state",
      "hermes/task_archive",
      "hermes/quarantine",
      "manager/runtime_sessions"
    ]
  },
  "callbacks": "hermes/callbacks",
  "callback_archive": "hermes/callback_archive",
  "command": "wsa-hermes-cli",
  "command_registry": "hermes/adapter_config/hermes_commands.example.json",
  "cwd": ".",
  "delivery": {
    "chat_summary": "allowed",
    "full_artifact": "local_report_or_file_attachment",
    "requires_human_approval": true,
    "safe_for_chat": false,
    "schema": "wsa.delivery.v1",
    "target": "origin"
  },
  "maintenance": "hermes/maintenance",
  "name": "example-hermes",
  "notes": [
    "Template only. Do not put raw secret values in this file.",
    "WSA writes task JSON; the Hermes CLI wrapper reads it and writes callback JSON."
  ],
  "operation_contract": {
    "action_request_format": {
      "approval_prompt_fields": [
        "exact_command",
        "meaning",
        "why_needed",
        "risks",
        "rollback"
      ],
      "message_type": "operation_request",
      "optional_fields": [
        "payload",
        "dry_run",
        "approval_prompt"
      ],
      "required_fields": [
        "action",
        "mode",
        "summary"
      ]
    },
    "actions": [
      {
        "action": "version_control.snapshot",
        "executor": "user_hermes_adapter",
        "modes": [
          "none",
          "local_commit",
          "remote_push",
          "custom"
        ],
        "notes": [
          "The WSA template declares intent only.",
          "Each Hermes runtime maps this action to its own local policy.",
          "Remote push, local commit, and disabled modes are all valid."
        ]
      }
    ],
    "approval": "user_required",
    "owner": "hermes_runtime",
    "schema": "wsa.hermes.operation_contract.v1"
  },
  "quarantine": "hermes/quarantine",
  "reports_outbox": "hermes/reports_outbox",
  "runtime_target": {
    "background": false,
    "callback_policy": {
      "callback_dir": "hermes/callbacks",
      "external_callback_paths": false,
      "quarantine_dir": "hermes/quarantine",
      "required": true
    },
    "interactive": false,
    "profile": "default",
    "schema": "wsa.hermes.runtime_target.v1",
    "session_mode": "callback_only",
    "skills": [],
    "source": "cli",
    "toolsets": [],
    "workdir": "."
  },
  "schema": "wsa.hermes.cli_config.example.v1",
  "secret_env": [
    "HERMES_BOT_TOKEN",
    "OPENAI_API_KEY"
  ],
  "sensitivity": {
    "contains_workspace_payloads": true,
    "level": "internal",
    "schema": "wsa.sensitivity.v1"
  },
  "task_queue": "hermes/task_queue",
  "task_archive": "hermes/task_archive",
  "task_state": "hermes/task_state",
  "timeout_seconds": 300,
  "workspace": {
    "env": "WSA_WORKSPACE",
    "path_policy": "relative_to_workspace_root",
    "root": "."
  }
}

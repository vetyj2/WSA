          "required": false
        }
      ],
      "category": "operations",
      "cli_templates": [
        [
          "wsa",
          "hermes",
          "task",
          "{world_id}",
          "--task-type",
          "fill_the_rest",
          "--title",
          "Fill the rest",
          "--instruction",
          "{destination}",
          "--session-mode",
          "cron",
          "--runtime-source",
          "cron",
          "--background",
          "--input-json",
          "{\"destination\":\"{destination}\",\"scope\":\"{scope}\",\"discretion_level\":\"{discretion_level:5}\",\"quality_gate\":\"required_before_completion\",\"completion\":\"stop_cron_then_report_and_request_approval\"}"
        ]
      ],
      "command": "/fill_the_rest",
      "delivery": {
        "default": "chat_summary",
        "full_artifact": "local_report_or_file_attachment"
      },
      "execution_policy": {
        "owner": "user_hermes_runtime",
        "requires_user_confirmation": true
      },
      "intent": "fill_remaining_lower_layer_candidates",
      "notes": [
        "Generates lower-layer candidate material only; it does not directly mutate canon.",
        "Can be used at initial setup, mid-project, or late-project cleanup.",
        "At discretion level 5 Hermes must ask for the destination checkpoint before starting cron automation.",
        "When the destination is met, Hermes must stop the cron job and explicitly report that it stopped.",
        "Before completion, Hermes must diagnose whether the generated material actually satisfies the destination and quality bar.",
        "After completion, Hermes should request user approval before canon conversion."
      ],
      "runtime_contract": {
        "approval_flow": "report_candidates_then_request_user_approval",
        "available_anytime": true,
        "candidate_scope": "lower_layer_information",
        "canon_policy": "generated_material_requires_user_or_policy_approval",
        "completion_must_state_cron_stopped": true,
        "cron_capable_at_discretion_level": 5,
        "cron_owner": "user_hermes_runtime",
        "must_stop_when_destination_met": true,
        "owner": "user_hermes_runtime",
        "purpose": "Prepare lower-layer autonomous candidate generation until a destination checkpoint.",
        "quality_gate": {
          "checks": [
            "destination_checkpoint_satisfied",
            "internal_consistency_reviewed",
            "duplicate_or_low_value_fill_removed",
            "approval_report_created"
          ],
          "required_before_completion": true
        },
        "requires_destination_checkpoint": true,
        "schema": "wsa.hermes.fill_the_rest_contract.v1"
      },
      "safety": "requires_approval",
      "title": "Prepare a cron-capable pass that fills remaining lower-layer world details."
    },
